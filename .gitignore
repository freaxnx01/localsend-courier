# Local configuration (contains host/IP and PIN)
sender/config.json
host/config.env

# Local runtime state / logs
*.log
state.json

# OS cruft
Thumbs.db
.DS_Store

# Local session/handoff state — ignore contents (NOT the dir itself, or the
# negation below cannot re-include: git never descends into an ignored directory)
.claude/*
# ...but per-branch handoffs are durable and meant to be committed
!.claude/handoff-*.md
# the index is derived from those, never committed
.claude/handoffs.md
