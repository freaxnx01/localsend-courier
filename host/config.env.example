# localsend-courier host configuration.
# Copy to config.env and edit. Sourced by receive.sh, delete-watcher.sh and the
# systemd unit files.

# Where received files (and delete markers) are written.
INBOX="$HOME/screenpresso-inbox"

# Suffix used for delete markers. MUST match the sender's deleteMarkerSuffix.
MARKER_SUFFIX=".localsend-delete"

# PIN required from senders (empty = none). Must match the sender.
PIN=""

# Use HTTPS transport. Must match the sender's "https" setting.
HTTPS="true"

# Device name advertised on the network.
DEVICE_NAME="screenpresso-host"

# Port to bind (empty = localsend-cli default, 53317). Must match the sender's
# "port". Set this only if the default port is already taken on the host.
PORT=""

# Path to the localsend-cli binary (command on PATH or absolute path).
LOCALSEND_CLI="localsend-cli"
